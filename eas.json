{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "channel": "main",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "ios-testflight": {
      "distribution": "store",
      "channel": "main",
      "environment": "preview",
      "autoIncrement": true
    },
    "production": {
      "channel": "production",
      "environment": "production",
      "autoIncrement": true
    }
  },
  "submit": {
    "ios-testflight": {},
    "production": {}
  }
}
